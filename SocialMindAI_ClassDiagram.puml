' ============================================================
' PACKAGE : Utilisateurs & Authentification
' ============================================================
package "Utilisateurs & Authentification" {

    class User {
        - id : int
        - nom : string
        - prenom : string
        - email : string
        - motDePasse : string
        - role : RoleEnum
        - statut : StatutEnum
        - emailVerifie : boolean
        - dateInscription : datetime
        - derniereConnexion : datetime
        - tokenJWT : string
        - tokenExpiration : datetime
        - oauthProvider : string
        - oauthId : string
        - twoFactorActive : boolean
        - twoFactorSecret : string
        --
        + seConnecter(email : string, mdp : string) : boolean
        + seDeconnecter() : void
        + sInscrire(nom : string, email : string, mdp : string, role : RoleEnum) : User
        + reinitialiserMotDePasse(email : string) : boolean
        + verifierEmail(token : string) : boolean
        + activerTwoFactor() : string
        + desactiverTwoFactor(code : string) : boolean
        + mettreAJourProfil(donnees : map) : boolean
        + supprimerCompte() : boolean
        + exporterDonnees() : JSON
        # verifierToken(token : string) : boolean
        # genererToken() : string
    }

    class UtilisateurStandard {
        - nbComptesReseauxMax : int = 2
        - planActif : string
        - outilsActives : list
        --
        + accederOutil(nomOutil : string) : boolean
        + connecterCompteReseau(reseau : string, token : string) : boolean
        + consulterTableauDeBord() : DashboardData
        + consulterResumeSemaine() : ResumeSemaine
        + consulterCalendrier() : list
    }

    class UtilisateurProfessionnel {
        - nbClientsMax : int
        - stripeConnectId : string
        - marqueBlanche : boolean
        - rapportsPDFActives : boolean
        --
        + ajouterClient(client : Client) : boolean
        + supprimerClient(clientId : int) : boolean
        + basculerEspaceClient(clientId : int) : boolean
        + consulterTableauDeBordPro() : DashboardProData
        + genererFactureClient(clientId : int, details : map) : Facture
        + accederAgentIA(nomAgent : string) : AgentIA
        + connecterStripeConnect(code : string) : boolean
    }

    class Administrateur {
        - niveauAcces : int
        - sessionExpirationMinutes : int = 30
        --
        + gererUtilisateurs() : list
        + suspendreCompte(userId : int) : boolean
        + banniCompte(userId : int) : boolean
        + modifierRoleUtilisateur(userId : int, role : RoleEnum) : boolean
        + declencherReinitialisationMdp(userId : int) : boolean
        + supprimerCompteCGPD(userId : int) : boolean
        + consulterPanneauAdmin() : AdminDashboard
        + configurerSysteme(config : map) : boolean
        + activerDesactiverFonctionnalite(flag : string, etat : boolean) : boolean
        + gererClesAPI(service : string, cle : string) : boolean
    }

    enum RoleEnum {
        STANDARD
        PROFESSIONNEL
        ADMIN
    }

    enum StatutEnum {
        ACTIF
        SUSPENDU
        BANNI
        EN_ATTENTE_VERIFICATION
    }

    class Session {
        - id : int
        - userId : int
        - token : string
        - dateCreation : datetime
        - dateExpiration : datetime
        - ipAdresse : string
        - userAgent : string
        --
        + creer(userId : int) : Session
        + invalider() : boolean
        + estValide() : boolean
        + prolonger() : boolean
    }
}

